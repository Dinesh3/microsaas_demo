# Switch DATABASE_URL when you decide on a database.
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./microsaas.db
# PostgreSQL example (uncomment and fill in when ready):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microsaas

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Seed data - the first admin account created on first run
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=Business Owner

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
